{
  "routes": [
    { "route": "/recipes", "rewrite": "/recipes/index.html" },
    { "route": "/menus", "rewrite": "/menus/index.html" },
    { "route": "/notes", "rewrite": "/notes/index.html" }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/assets/*", "/images/*", "/*.{css,js,svg,png,jpg,jpeg,webp,avif,ico,xml,txt,json}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY"
  }
}
