---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Ornament from '../../components/Ornament.astro';
import { getNotes, isFixture, slugFor, type NoteEntry } from '../../lib/content';
export async function getStaticPaths() { return (await getNotes()).map(note => ({ params: { slug: slugFor(note) }, props: { note } })); }
interface Props { note: NoteEntry }
const { note } = Astro.props;
const { Content } = await render(note);
const fixture = isFixture(note);
---
<BaseLayout title={note.data.title} description={note.data.description} type="article" noindex={fixture}>
  {fixture && <div class="fixture-ribbon">Development fixture · excluded from production</div>}
  <header class="page-masthead"><div class="shell relative z-10 py-14 lg:py-20"><div class="flex flex-wrap gap-4"><p class="eyebrow text-brass-bright">{note.data.topic}</p><StatusBadge status={note.data.editorialStatus}/></div><h1 class="mt-7 max-w-5xl font-display text-[clamp(3rem,7vw,6rem)] leading-[.9] tracking-[-.035em]">{note.data.title}</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-cream/72">{note.data.description}</p></div></header>
  <div class="shell py-12 lg:py-16"><Ornament class="mb-9 text-brass" /><article class="prose max-w-3xl"><Content /></article></div>
</BaseLayout>
