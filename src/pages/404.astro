---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
---
<BaseLayout title="Page Not Found" description="That page has wandered off. Return to The Tipsy Goose kitchen." noindex={true}>
  <section class="shell flex min-h-[64vh] items-center py-16">
    <div class="paper-panel grid w-full gap-8 p-7 sm:p-12 lg:grid-cols-[.38fr_1fr] lg:items-end">
      <p class="font-display text-[8rem] leading-[.7] text-brass sm:text-[11rem]">404</p>
      <div><p class="eyebrow">Loose goose</p><Ornament class="mt-5 text-brass" compact /><h1 class="section-title mt-7">This page flew the coop.</h1><p class="mt-6 max-w-xl text-lg text-ink/65">The link may be stale, the address may have a typo, or somebody left the pantry door open.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/" class="button button--solid">Back to the kitchen</a><a href="/recipes" class="button">Browse recipes</a></div></div>
    </div>
  </section>
</BaseLayout>
