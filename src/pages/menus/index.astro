---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Ornament from '../../components/Ornament.astro';
import { getMenus, isFixture, showFixtures, slugFor } from '../../lib/content';
const menus = await getMenus();
---
<BaseLayout title="Dinner Menus" description="Coordinated dinner menus with linked recipes and practical preparation and service timelines." noindex={showFixtures && menus.length > 0}>
  {showFixtures && <div class="fixture-ribbon">Development preview · fixture content is visible and will not ship</div>}
  <header class="page-masthead"><div class="shell relative z-10 py-14 text-center lg:py-20"><p class="eyebrow text-brass-bright">A whole evening</p><h1 class="section-title mx-auto mt-5 max-w-4xl">Dinner is more than several recipes arriving at once.</h1><p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-cream/72">Coordinated menus with the order of operations included—because timing is an ingredient, and nobody wants the host trapped at the stove.</p></div></header>
  <section class="shell py-12 lg:py-16">
    <Ornament class="mx-auto mb-10 text-brass" />
    {menus.length ? <div class="grid gap-6 md:grid-cols-2">{menus.map(menu => <article class="menu-sheet p-7 text-center sm:p-10"><div class="flex items-center justify-center gap-4"><p class="eyebrow">Serves {menu.data.servings}</p>{isFixture(menu) && <span class="text-xs font-bold text-rust uppercase">Fixture</span>}</div><Ornament class="mx-auto mt-6 text-brass" compact /><h2 class="mt-9 text-4xl tracking-[-.025em] sm:text-5xl"><a href={`/menus/${slugFor(menu)}/`} class="decoration-brass underline-offset-8">{menu.data.title}</a></h2><p class="mx-auto mt-5 max-w-xl italic text-ink/65">{menu.data.description}</p><div class="mt-8"><StatusBadge status={menu.data.editorialStatus}/></div></article>)}</div> : <EmptyState type="menus" />}
  </section>
</BaseLayout>
