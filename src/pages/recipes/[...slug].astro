---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Ornament from '../../components/Ornament.astro';
import { cocktailSlugFor, getCocktails, getRecipes, isFixture, minutesToIso, slugFor, type RecipeEntry } from '../../lib/content';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map(recipe => ({ params: { slug: slugFor(recipe) }, props: { recipe } }));
}

interface Props { recipe: RecipeEntry }
const { recipe } = Astro.props;
const { Content } = await render(recipe);
const d = recipe.data;
const fixture = isFixture(recipe);
const cocktails = await getCocktails();
const relatedCocktails = d.relatedCocktails.map(slug => cocktails.find(cocktail => cocktailSlugFor(cocktail) === slug)).filter(cocktail => cocktail !== undefined);
const url = new URL(`/recipes/${slugFor(recipe)}/`, Astro.site).href;
const ingredients = d.ingredientGroups.flatMap(group => group.ingredients.map(item => [item.quantity, item.unit, item.item, item.note].filter(Boolean).join(' ')));
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  datePublished: d.publishedAt.toISOString(),
  url,
  recipeCategory: d.category,
  recipeYield: `${d.yield.amount} ${d.yield.unit}`,
  recipeIngredient: ingredients,
  recipeInstructions: d.instructionGroups.flatMap(group => group.steps.map(step => ({ '@type': 'HowToStep', text: step }))),
  keywords: d.tags.join(', '),
  ...(d.updatedAt ? { dateModified: d.updatedAt.toISOString() } : {}),
  ...(d.times.prep ? { prepTime: minutesToIso(d.times.prep) } : {}),
  ...(d.times.cook ? { cookTime: minutesToIso(d.times.cook) } : {}),
  ...(d.times.total ? { totalTime: minutesToIso(d.times.total) } : {}),
  ...(d.heroImage ? { image: new URL(d.heroImage.src, Astro.site).href } : {}),
};
const formatQuantity = (n: number) => {
  const rounded = Math.round(n * 100) / 100;
  const whole = Math.floor(rounded);
  const fraction = rounded - whole;
  const fractions: Record<string, string> = { '0.25': '¼', '0.33': '⅓', '0.5': '½', '0.67': '⅔', '0.75': '¾' };
  const frac = fractions[String(Math.round(fraction * 100) / 100)];
  return frac ? `${whole || ''}${frac}` : String(rounded);
};
---
<BaseLayout title={d.title} description={d.description} type="article" noindex={fixture} jsonLd={jsonLd} image={d.heroImage?.src}>
  {fixture && <div class="fixture-ribbon">Development fixture · not tested for publication · excluded from production</div>}
  <article>
    <header class="recipe-intro page-masthead">
      <div class="shell relative z-10 grid gap-12 py-14 lg:grid-cols-[1fr_.45fr] lg:items-end lg:py-20">
        <div><div class="flex flex-wrap items-center gap-3"><p class="eyebrow text-brass-bright">{d.kind} · {d.category}</p><StatusBadge status={d.editorialStatus}/></div><h1 class="mt-7 font-display text-[clamp(3.1rem,7vw,6rem)] leading-[.9] tracking-[-.04em]">{d.title}</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-cream/75">{d.description}</p><div class="mt-8 flex flex-wrap gap-3"><a href="#recipe" class="button border-cream text-cream">Jump to recipe</a><button type="button" class="button border-cream/30 text-cream" onclick="window.print()">Print</button></div></div>
        <dl class="grid grid-cols-2 border border-cream/25 text-center">
          {d.times.prep !== undefined && <div class="border-b border-r border-cream/20 p-4"><dt class="text-[.65rem] font-bold tracking-wider uppercase text-cream/50">Prep</dt><dd class="mt-1 font-display text-2xl">{d.times.prep} min</dd></div>}
          {d.times.cook !== undefined && <div class="border-b border-cream/20 p-4"><dt class="text-[.65rem] font-bold tracking-wider uppercase text-cream/50">Cook</dt><dd class="mt-1 font-display text-2xl">{d.times.cook} min</dd></div>}
          {d.times.total !== undefined && <div class="border-r border-cream/20 p-4"><dt class="text-[.65rem] font-bold tracking-wider uppercase text-cream/50">Total</dt><dd class="mt-1 font-display text-2xl">{d.times.total} min</dd></div>}
          <div class="p-4"><dt class="text-[.65rem] font-bold tracking-wider uppercase text-cream/50">Makes</dt><dd class="mt-1 font-display text-2xl">{d.yield.amount} {d.yield.unit}</dd></div>
        </dl>
      </div>
    </header>

    <div class="shell grid gap-10 py-12 lg:grid-cols-[1fr_.34fr] lg:items-start lg:py-16">
      <div>
        <Ornament class="mb-9 text-brass" />
        <div class="prose max-w-3xl"><Content /></div>
        <section id="recipe" class="recipe-sheet menu-sheet mt-14 scroll-mt-6 p-5 sm:p-8">
          <div class="flex flex-wrap items-end justify-between gap-5 border-b border-green/20 pb-6">
            <div><p class="eyebrow">The working recipe</p><h2 class="mt-3 text-4xl tracking-[-.025em] sm:text-5xl">{d.title}</h2></div>
            <label class="no-print text-xs font-bold tracking-wider uppercase">Servings
              <select id="serving-adjuster" data-base-yield={d.yield.amount} class="ml-2 min-h-11 border border-green/30 bg-cream px-3">
                {[0.5, 1, 1.5, 2].map(multiplier => <option value={multiplier} selected={multiplier === 1}>{formatQuantity(d.yield.amount * multiplier)} {d.yield.unit}</option>)}
              </select>
            </label>
          </div>
          <div class="recipe-columns mt-8 grid gap-10 md:grid-cols-[.85fr_1.15fr]">
            <div>
              <h2 class="text-3xl">Ingredients</h2>
              {d.ingredientGroups.map(group => <section class="mt-7"><h3 class="text-xl italic">{group.name}</h3><ul class="mt-3 list-none space-y-3 p-0">{group.ingredients.map(ingredient => <li><label class="group flex cursor-pointer items-start gap-3 text-[.96rem] leading-6"><input type="checkbox" class="ingredient-check mt-1 h-4 w-4 accent-green"/><span class="group-has-checked:line-through group-has-checked:opacity-45">{ingredient.quantity && <strong class="ingredient-quantity" data-base={ingredient.quantity}>{formatQuantity(ingredient.quantity)}</strong>} {ingredient.unit} {ingredient.item}{ingredient.note && <span class="text-ink/55">, {ingredient.note}</span>}</span></label></li>)}</ul></section>)}
            </div>
            <div>
              <h2 class="text-3xl">Instructions</h2>
              {d.instructionGroups.map(group => <section class="mt-7"><h3 class="text-xl italic">{group.name}</h3><ol class="mt-4 space-y-6 pl-7">{group.steps.map(step => <li class="pl-2 text-[.98rem] leading-7 marker:font-display marker:text-xl marker:text-rust">{step}</li>)}</ol></section>)}
            </div>
          </div>
        </section>
      </div>
      <aside class="recipe-asides space-y-5 lg:sticky lg:top-5">
        {d.statusNote && <section class="card p-5"><p class="eyebrow">Status note</p><p class="mt-3 text-sm leading-6">{d.statusNote}</p></section>}
        {d.equipment.length > 0 && <section class="card p-5"><h2 class="font-sans text-xs font-extrabold tracking-wider uppercase">Equipment</h2><ul class="mt-3 space-y-2 text-sm">{d.equipment.map(item => <li>{item}</li>)}</ul></section>}
        {d.substitutions.length > 0 && <section class="card p-5"><h2 class="font-sans text-xs font-extrabold tracking-wider uppercase">Substitutions</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{d.substitutions.map(item => <li>{item}</li>)}</ul></section>}
        {d.makeAhead.length > 0 && <section class="card p-5"><h2 class="font-sans text-xs font-extrabold tracking-wider uppercase">Make ahead</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{d.makeAhead.map(item => <li>{item}</li>)}</ul></section>}
        {d.techniqueNotes.length > 0 && <section class="card p-5"><h2 class="font-sans text-xs font-extrabold tracking-wider uppercase">Technique notes</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{d.techniqueNotes.map(item => <li>{item}</li>)}</ul></section>}
        {relatedCocktails.length > 0 && <section class="card p-5"><h2 class="font-sans text-xs font-extrabold tracking-wider uppercase">Cocktails for the table</h2><ul class="mt-3 space-y-2 text-sm">{relatedCocktails.map(cocktail => <li><a class="text-rust underline decoration-brass underline-offset-4" href={`/cocktails/recipes/${cocktailSlugFor(cocktail)}/`}>{cocktail.data.title}</a></li>)}</ul></section>}
        {d.aiContribution?.used && <section class="border border-brass/40 bg-[#efe1c8] p-5"><p class="eyebrow">AI contribution</p>{d.aiContribution.note && <p class="mt-3 text-sm leading-6">{d.aiContribution.note}</p>}{d.aiContribution.changedAfterCooking && <p class="mt-3 text-sm leading-6"><strong>Changed after cooking:</strong> {d.aiContribution.changedAfterCooking}</p>}</section>}
      </aside>
    </div>
  </article>
  <script>
    const adjuster = document.querySelector<HTMLSelectElement>('#serving-adjuster');
    const quantities = [...document.querySelectorAll<HTMLElement>('.ingredient-quantity')];
    const format = (value: number) => {
      const rounded = Math.round(value * 100) / 100;
      const whole = Math.floor(rounded);
      const fraction = Math.round((rounded - whole) * 100) / 100;
      const glyphs: Record<string, string> = { '0.25': '¼', '0.33': '⅓', '0.5': '½', '0.67': '⅔', '0.75': '¾' };
      const glyph = glyphs[String(fraction)];
      return glyph ? `${whole || ''}${glyph}` : String(rounded);
    };
    adjuster?.addEventListener('change', () => {
      const multiplier = Number(adjuster.value);
      quantities.forEach(quantity => quantity.textContent = format(Number(quantity.dataset.base) * multiplier));
    });
  </script>
</BaseLayout>
