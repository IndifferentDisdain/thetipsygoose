---
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import Ornament from './Ornament.astro';
import { isFixture, slugFor, type RecipeEntry } from '../lib/content';
interface Props { recipe: RecipeEntry }
const { recipe } = Astro.props;
const slug = slugFor(recipe);
---
<article class="card recipe-card group flex h-full flex-col" data-recipe-card data-title={recipe.data.title.toLowerCase()} data-kind={recipe.data.kind} data-category={recipe.data.category.toLowerCase()} data-tags={recipe.data.tags.join('|').toLowerCase()}>
  {recipe.data.heroImage ? <Image src={recipe.data.heroImage} alt="" width={640} height={440} class="aspect-[4/2.7] w-full border-b border-brass object-cover" /> : <div class="recipe-card__art" aria-hidden="true"><Ornament class="text-brass-bright" /></div>}
  <div class="flex flex-1 flex-col p-5">
  <div class="mb-9 flex items-start justify-between gap-4">
    <span class="eyebrow">{recipe.data.kind}</span>
    {isFixture(recipe) && <span class="text-[.62rem] font-extrabold tracking-wider text-rust uppercase">Development fixture</span>}
  </div>
  <h2 class="text-[2.15rem] tracking-[-.025em]"><a href={`/recipes/${slug}/`} class="no-underline">{recipe.data.title}</a></h2>
  <p class="mt-4 flex-1 text-sm leading-6 text-ink/70">{recipe.data.description}</p>
  <div class="mt-7 flex items-end justify-between gap-3 border-t border-green/15 pt-4">
    <div><p class="text-xs font-bold uppercase tracking-wider">{recipe.data.category}</p><p class="mt-1 text-xs text-ink/50">{recipe.data.yield.amount} {recipe.data.yield.unit}</p></div>
    <StatusBadge status={recipe.data.editorialStatus} />
  </div>
  </div>
</article>
