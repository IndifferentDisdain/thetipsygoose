---
import { Image } from 'astro:assets';
import gooseEmblem from '../assets/brand/goose-emblem.png';
const path = Astro.url.pathname;
const links = [
  ['/recipes', 'Recipes'],
  ['/menus', 'Dinner menus'],
  ['/notes', 'Kitchen notes'],
  ['/about', 'About'],
];
---
<header class="relative z-30 border-b border-brass bg-green text-paper">
  <div class="shell flex min-h-20 items-center justify-between gap-4 py-2.5 sm:min-h-24 sm:py-3">
    <a href="/" class="group flex items-center gap-3 no-underline" aria-label="The Tipsy Goose home">
      <Image src={gooseEmblem} alt="" width={58} height={66} class="h-14 w-auto object-contain transition-transform duration-200 group-hover:-rotate-2 sm:h-18" />
      <span class="leading-none">
        <span class="block font-display text-[1.55rem] font-semibold tracking-[-.025em] text-paper sm:text-[2rem]">The Tipsy Goose</span>
        <span class="mt-1 hidden font-sans text-[.55rem] font-bold tracking-[.24em] text-brass-bright uppercase sm:block">Kitchen & cocktail journal</span>
      </span>
    </a>
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex list-none items-center gap-7 p-0 text-[.7rem] font-extrabold tracking-[.13em] uppercase">
        {links.map(([href, label]) => <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined} class:list={["border-b border-transparent pb-1 no-underline transition hover:border-brass hover:text-brass-bright", { "border-brass text-brass-bright": path.startsWith(href) }]}>{label}</a></li>)}
      </ul>
    </nav>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none border border-brass/70 px-3 py-2 font-sans text-[.65rem] font-bold tracking-[.16em] uppercase">Menu</summary>
      <nav aria-label="Mobile" class="absolute right-0 z-40 mt-2 w-56 border border-brass bg-paper p-3 text-ink shadow-xl">
        <ul class="m-0 list-none p-0">
          {links.map(([href, label]) => <li><a href={href} class="block px-3 py-3 text-sm font-bold no-underline">{label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
